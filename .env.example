# SDK (reads process environment; examples do not auto-load .env)
XRAY_API_URL=http://localhost:5000
XRAY_API_KEY=your-xray-key

# API: SQLite default; install the postgres extra for PostgreSQL
# DATABASE_URL=postgresql://user:password@host/database
# XRAY_CORS_ORIGINS=https://your-browser-application.example

# Analysis is optional; analyze=False stores without a provider
LLM_PROVIDER=openai
OPENAI_API_KEY=your-provider-key
OPENAI_MODEL=gpt-4o-mini

# Install openai extra for all OpenAI-compatible providers
# CEREBRAS_API_KEY=your-key
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# GROQ_API_KEY=your-key
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=your-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Install anthropic extra
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama uses only server extra; no key required
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Provider settings, not SDK HTTP settings
XRAY_MAX_PROMPT_CHARS=32000
XRAY_LLM_TIMEOUT=20
XRAY_LLM_MAX_RETRIES=0
XRAY_LLM_JSON_MODE=true
